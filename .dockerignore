# Exclude version control and development metadata
.git
.gitignore
.github

# Exclude local build artifacts and caches
node_modules
.next
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# CRITICAL: Exclude local environment files containing secrets
.env
.env*.local
.env.production
.env.staging

# Exclude IDE and temporary files
.vscode
.idea
*.suo
*.ntvs*
*.njsproj

# Exclude test reports and scripts not needed in container image
coverage
scripts/test*
README.md
