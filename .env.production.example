# ==============================================================================
# HOMACEBUILD AND REALATORS - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# SECURITY NOTICE:
# 1. Never commit real production secrets into version control.
# 2. On production Linux hosts, restrict access: chmod 600 .env.production
# 3. Ensure server-side keys (e.g. SUPABASE_SERVICE_ROLE_KEY) NEVER have NEXT_PUBLIC_ prefixes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Canonical public website URL (Must use HTTPS and contain no trailing slash)
NEXT_PUBLIC_SITE_URL=https://homacebuild.com
NEXT_PUBLIC_SITE_NAME="HomaceBuild and Realators"
NEXT_PUBLIC_DEFAULT_CITY="Islamabad"
NEXT_PUBLIC_PRIMARY_MARKETS="Bahria Town, DHA, Islamabad, Rawalpindi"

# Reverse Proxy (Caddy / Nginx) Domain Bindings
DOMAIN_NAME=homacebuild.com
WWW_DOMAIN_NAME=www.homacebuild.com

# ------------------------------------------------------------------------------
# 2. OFFICIAL COMMUNICATION & LEAD DESK DETAILS
# ------------------------------------------------------------------------------
# Format: International format without '+' or spaces for WhatsApp wa.me links
NEXT_PUBLIC_WHATSAPP_NUMBER=923006100619
NEXT_PUBLIC_CONTACT_PHONE="+92 300 6100619"
NEXT_PUBLIC_CONTACT_EMAIL="info@homacebuild.com"

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & STORAGE CREDENTIALS
# ------------------------------------------------------------------------------
# Retrieve from: Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-LONG-ANON-PUBLIC-KEY]

# CRITICAL SERVER-ONLY SECRET (Bypasses Row Level Security)
# Used ONLY in secure server actions (e.g., inquiry lead dispatch, media admin)
# NEVER EXPOSE TO BROWSER / CLIENT BUNDLES!
SUPABASE_SERVICE_ROLE_KEY=[YOUR-LONG-SERVICE-ROLE-KEY]

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL LEAD DISPATCH (PROVIDER: RESEND)
# ------------------------------------------------------------------------------
# Free tier supports 100 emails/day, 3,000/month.
# Pro tier ($20/mo) supports 50,000 emails/month.
# Inquiries are permanently stored in PostgreSQL regardless of email delivery.
RESEND_API_KEY=re_1234567890abcdef
NOTIFICATION_ALERT_EMAIL=advisory@homacebuild.com
NOTIFICATION_FROM_EMAIL="HomaceBuild Lead Desk <leads@homacebuild.com>"

# ------------------------------------------------------------------------------
# 5. SPAM & BOT DEFENSE (CLOUDFLARE TURNSTILE - OPTIONAL BUT RECOMMENDED)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...
