# ==========================================
# HOMACEBUILD AND REALATORS - ENVIRONMENT CONFIGURATION
# ==========================================

# Public Website & Branding
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="HomaceBuild and Realators"
NEXT_PUBLIC_DEFAULT_CITY="Islamabad"
NEXT_PUBLIC_PRIMARY_MARKETS="Bahria Town, DHA, Islamabad, Rawalpindi"

# Official Communication Channels (Replace with actual numbers/emails when ready)
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000
NEXT_PUBLIC_CONTACT_PHONE="+92 300 0000000"
NEXT_PUBLIC_CONTACT_EMAIL="info@homacebuild.com"

# Supabase Public Client Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Side Secret Key (DO NOT EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anti-Bot & Abuse Prevention (Optional in local development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional Email Lead Notifications (Optional - Provider: Resend)
# Inquiries are stored in the database regardless of whether email is enabled.
RESEND_API_KEY=
NOTIFICATION_ALERT_EMAIL=advisory@homacebuild.com
NOTIFICATION_FROM_EMAIL="HomaceBuild Advisory <leads@homacebuild.com>"
